 int getSecondLargest(vector<int> &arr) {
        int max=arr[0];
        int smax=-1;
        for(int i=0;i<arr.size();i++){
            if(arr[i]>max){
                max=arr[i];
            }
        }
        for(int i=0;i<arr.size();i++){
            if(smax<arr[i] && arr[i]!=max){
                smax=arr[i];
            }
        }
        if(max==smax) return -1;
        return smax;
    }
